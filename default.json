{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "pyenv": {
    "enabled": false
  },
  "packageRules": [
    {
      "groupName": "minor/patch pip dependencies",
      "matchManagers": [
        "pip_requirements"
      ]
    },
    {
      "groupName": "GitHub Actions",
      "matchManagers": ["github-actions"],
      "automerge": true
    },
    {
      "description": "Major GitHub Actions updates can be breaking, so they aren't automerged",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}
