{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "pyenv": {
    "enabled": false
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-9 * * 1"]
  },
  "packageRules": [
    {
      "matchManagers": [
        "pep621",
        "pip_requirements"
      ],
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "branchTopic": "python-lockfile-maintenance",
      "commitMessageAction": "Python lock file maintenance"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "branchTopic": "node-lockfile-maintenance",
      "commitMessageAction": "Node lock file maintenance"
    },
    {
      "groupName": "minor/patch pip dependencies",
      "matchManagers": [
        "pip_requirements"
      ]
    },
    {
      "groupName": "GitHub Actions",
      "matchManagers": ["github-actions"],
      "automerge": true
    },
    {
      "description": "Major GitHub Actions updates can be breaking, so they aren't automerged",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}
