{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "pyenv": {
    "enabled": false
  },
  "packageRules": [
    {
      "groupName": "minor/patch pip dependencies",
      "matchManagers": [
        "pip_requirements"
      ]
    },
    {
      "description": "Lock file maintenance has no release timestamp, so minimumReleaseAge keeps it pending forever. pnpm and uv apply the age gate instead",
      "matchManagers": [
        "pep621",
        "pip_requirements"
      ],
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "branchTopic": "python-lockfile-maintenance",
      "commitMessageAction": "Python lock file maintenance",
      "minimumReleaseAge": null
    },
    {
      "groupName": "GitHub Actions",
      "matchManagers": ["github-actions"],
      "automerge": true
    }
  ]
}
